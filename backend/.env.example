# Copy to backend/.env and fill in. Never commit backend/.env.

# Pooled connection, used by the API (on Neon: the "-pooler" host).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Direct (non-pooled) connection, used by init_db, the loaders, seed_mock and the tests.
# They need session-level temp tables and COPY. Leave unset for a local Postgres to reuse DATABASE_URL.
DIRECT_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
